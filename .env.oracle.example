# SPDX-License-Identifier: Apache-2.0
# Copy to .env.oracle. This file contains no credentials.
# Used only with: docker compose --env-file .env.oracle -f compose.oracle.yaml ...
RAVEN_LOCAL_PORT=8080
RATE_LIMIT_PER_MIN=120
RAVEN_MAX_COMPUTE_SECONDS=120
TELEMETRY_MAX_SUBSCRIBERS_PER_CLIENT=3
TELEMETRY_MAX_STREAM_SECONDS=300
# Absolute path recommended. The file must be readable by container UID 65532.
# Its CONTENT is the Cloudflare Tunnel token; never place that token in this file.
TUNNEL_TOKEN_FILE=./.secrets/cloudflare-tunnel-token
