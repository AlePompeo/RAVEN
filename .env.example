# SPDX-License-Identifier: Apache-2.0
# Copiare in .env (non versionato). Nessun segreto qui: solo valori di esempio.
# Le variabili numeriche devono essere interi/numeri > 0: un valore non valido ferma
# l'avvio con un messaggio che nomina la variabile (nessun ripiego silenzioso).

# --- Generale ---------------------------------------------------------------
# "prod" abilita HSTS (solo dietro HTTPS).
ENV=dev
# Origini CORS consentite, separate da virgola (vuoto = CORS disattivato).
CORS_ORIGINS=
# Cartella con il frontend gia' compilato da servire (vuoto = non servito).
STATIC_DIR=
# Richieste al minuto per client.
RATE_LIMIT_PER_MIN=120
# 1 solo se dietro un reverse proxy fidato (usa X-Forwarded-For).
TRUSTED_PROXY=0
# Dimensione massima del corpo delle richieste, in byte.
MAX_BODY_BYTES=65536

# --- Telemetria e chat --------------------------------------------------------
# Percorso CSV per il replay della telemetria (vuoto = disabilitato).
TELEMETRY_CSV=
TELEMETRY_SITE_ID=demo
TELEMETRY_MAX_SUBSCRIBERS=100
# Stream contemporanei per client e durata massima della connessione (secondi).
TELEMETRY_MAX_SUBSCRIBERS_PER_CLIENT=3
TELEMETRY_MAX_STREAM_SECONDS=300
# Durata massima di uno stream di chat, in secondi.
CHAT_MAX_STREAM_SECONDS=120

# --- Simulazioni e stimatori ----------------------------------------------------
# Simulazioni eseguite in parallelo (oltre: 503). Vedi backend/api/routes.py.
SIM_MAX_CONCURRENT=8
# Sessioni di stimatori vive contemporaneamente (LRU).
ESTIMATOR_MAX_SESSIONS=64

# --- ML (extra [ml], [rl], [dl]) ---------------------------------------------------
# Cartella del registro modelli (default: build/models, ignorata da git).
MODEL_REGISTRY_DIR=
# Candidati massimi nel registro (si potano i piu' vecchi non promossi).
ML_MAX_CANDIDATES=50
# Addestramenti per ora e per IP.
ML_TRAIN_PER_HOUR=20

# --- Pipeline dati (extra [data]) ----------------------------------------------------
# Impostare per abilitare la pipeline (vuoto = disabilitata). Cartella scrivibile solo dal servizio.
PIPELINE_DIR=
# memory (default) oppure durable (SQLite in PIPELINE_DIR/queue).
PIPELINE_QUEUE=memory
# Query DuckDB contemporanee (oltre: 503).
PIPELINE_MAX_QUERIES=4
# Secondi di silenzio dopo cui una sorgente risulta "stale".
PIPELINE_STALE_AFTER_S=300
# Tentativi per infrastruttura prima della dead-letter.
PIPELINE_MAX_INFRA_RETRIES=20
# Dead-letter consecutive per scarto prima di aprire il circuit breaker.
PIPELINE_POISON_BREAKER=50
# Attesa massima (s) del lavoro in corso allo spegnimento.
PIPELINE_SHUTDOWN_WAIT_S=30
# Sorgente CSV di esempio per la pipeline.
INGEST_CSV_PATH=
INGEST_CSV_SITE_ID=demo

# --- Rete (backend/net) ---------------------------------------------------------------
# ATTENZIONE: backend.net NON e' ancora collegato all'app, quindi oggi questa variabile non avvia
# nessun listener (vedi docs/net.md). Resta documentata per l'integrazione futura (JSON dei listener).
NET_LISTENERS=
# Impostare a 1 solo per consentire bind non loopback. Lasciare 0 in locale.
NET_ALLOW_PUBLIC_BIND=0

# --- Learning Assistant (backend/assistant, docs/assistant.md) --------------------------------
# Provider LLM. assistant-extractive = nessuna chiave, nessuna rete, sempre disponibile.
# auto (default): sceglie da solo il miglior modello disponibile (docs/assistant.md); un id
# (assistant-extractive, ollama, assistant-openai-compat) forza quel provider.
ASSISTANT_PROVIDER=auto
# Ordine di preferenza: provider[:modello-glob] separati da virgola (l'estrattivo e' sempre ultimo).
ASSISTANT_PREFERENCE=groq,ollama:llama3.1*,ollama:granite4*,ollama:phi4*,ollama:gemma3*,ollama,assistant-openai-compat,assistant-extractive
# Optional RAVEN SI online prose. Requires BOTH server opt-in and per-request user consent.
# A key alone never enables cloud use. Keep the key only in the server's secret environment.
RAVEN_SI_CLOUD_ENABLED=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Classifica misurata dal benchmark (python -m backend.assistant.bench); ignorata se manca.
ASSISTANT_RANKING_FILE=build/assistant-ranking.json
# Punteggio minimo (0-1) sotto il quale un modello misurato non viene scelto in auto.
ASSISTANT_MIN_SCORE=0.6
# Instradamento opzionale delle domande di definizione verso un modello piu' rapido (solo se
# la classifica lo marca come sopra soglia). 1 = attivo.
ASSISTANT_ROUTE_SIMPLE=0
# Scoperta dei modelli: sonda SOLO Ollama (default locale; "off" la disattiva) e l'endpoint
# ASSISTANT_LLM_BASE_URL. Mai scansioni di rete.
ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
# Modello locale incluso (llama.cpp su 127.0.0.1, installato con ./install.sh --with-llm; parte alla prima richiesta, si ferma da solo).
# Cartella (default build/llm), RAM libera minima in MB (default: quella scritta dall'installer, 4096 per il 3B) e secondi di inattivita' prima dello scarico.
# RAVEN_LLM_DIR=
# RAVEN_LLM_MIN_FREE_MB=4096
# RAVEN_LLM_IDLE_S=300
ASSISTANT_DISCOVERY_TTL_S=60
ASSISTANT_DISCOVERY_TIMEOUT_S=2
# Host (nomi, separati da virgola) da considerare locali oltre a loopback/IP privati (es. "ollama" in Docker).
ASSISTANT_LOCAL_HOSTS=
# Circuit breaker per modello e budget di tempo per richiesta per il failover.
ASSISTANT_BREAKER_FAILURES=3
ASSISTANT_BREAKER_COOLDOWN_S=30
ASSISTANT_FAILOVER_BUDGET_S=120
# Solo per assistant-openai-compat. Esempio Ollama locale: http://localhost:11434/v1
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=
# Chiave: SOLO da ambiente/segreto, mai nel client ne' nei log (Ollama accetta qualunque valore).
ASSISTANT_LLM_API_KEY=
# Cartelle di conoscenza aggiuntive, separate da ':' (oltre a docs/knowledge e plugins/*/knowledge).
ASSISTANT_KNOWLEDGE_DIRS=
# 1 = ricostruisce l'indice quando i file di conoscenza cambiano (sviluppo).
ASSISTANT_DEV_RELOAD=0
# Budget di contesto (token stimati) e passaggi massimi passati al modello.
ASSISTANT_MAX_CONTEXT_TOKENS=1800
ASSISTANT_TOP_K=5
# Tetti sulla richiesta di chat dell'assistente.
ASSISTANT_MAX_MESSAGES=20
ASSISTANT_MAX_MESSAGE_CHARS=2000
# Chiamate al provider LLM per minuto e per IP (oltre: risposta estrattiva con avviso).
ASSISTANT_LLM_PER_MIN_PER_IP=20

# --- Efemeridi (extra `sky`, vedi docs/ephemeris.md) ---------------------------------
# Cartella dei kernel NAIF scaricati con `make ephemeris` (vuoto = build/ephemeris).
EPHEMERIS_DIR=
# Rotte /api/sky (efemeridi): tetti. Vedi docs/ephemeris.md.
SKY_MAX_CONCURRENT=4
SKY_MAX_POINTS=2000
SKY_MIN_STEP_S=60
SKY_MAX_SPAN_DAYS=366
SKY_CACHE_SIZE=512
SKY_CACHE_ROUND_S=1

# --- Analisi lunare (/api/lunar, vedi docs/domain/method.md) ------------------------
# Analisi concorrenti (503 oltre il tetto), voci della cache LRU, punti totali delle serie per i grafici.
LUNAR_MAX_CONCURRENT=2
LUNAR_CACHE_SIZE=32
LUNAR_MAX_TOTAL_POINTS=20000

# --- RAVEN (/api/raven, vedi docs/domain/raven-model.md) ---------------------------------
# Valutazioni concorrenti (503 oltre il tetto) e voci della cache LRU.
RAVEN_MAX_CONCURRENT=2
RAVEN_CACHE_SIZE=32
# Timeout della risposta HTTP; il worker mantiene il posto fino alla fine reale.
RAVEN_MAX_COMPUTE_SECONDS=120

# --- GrazingLink (/api/grazing, vedi docs/domain/grazinglink-plan.md) -------------------
# Cartella dei tile LOLA (vuoto = build/lola); 0 = niente download a richiesta (solo cache, `make grazing-dem`).
GRAZING_DEM_DIR=
GRAZING_DEM_ALLOW_DOWNLOAD=1
# Analisi concorrenti (503 oltre il tetto) e voci della cache LRU.
GRAZING_MAX_CONCURRENT=2
GRAZING_CACHE_SIZE=16

# PDF del report generato dal server (extra pdf): richieste al minuto per client, rese concorrenti (503 oltre), tempo massimo in secondi (504).
PDF_RATE_PER_MIN=10
PDF_MAX_CONCURRENT=2
PDF_TIMEOUT_S=60
# Data di creazione del PDF se la richiesta non la fornisce (build riproducibili); vuota = ora corrente.
SOURCE_DATE_EPOCH=
